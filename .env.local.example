# Copy this file to .env.local and fill in real values from
# Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Server-only. Required for trusted order creation and customer management.
# Never prefix this key with NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only API.co.id credentials and store origin. Never use NEXT_PUBLIC_.
APICO_API_KEY=your-api-co-id-key
APICO_ORIGIN_VILLAGE_CODE=3205021003

# Optional server-only Discord order notifications.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook
DISCORD_NOTIFY_USER_ID=your-discord-user-id
